# Selección de proveedor de LLM: "gemini" o "groq"
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL_NAME=gemini-3-flash-preview

# Groq
GROQ_API_KEY=tu_groq_api_key_aqui
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# HuggingFace Token (Opcional)
HF_TOKEN=tu_token_aqui_hf_

# Arize Phoenix Telemetría & Trazabilidad (OpenInference)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=orquestador-multi-agente

#base de datos vectorial
PINECONE_API_KEY=tu_pinecone_api_key_aqui
PINECONE_INDEX_NAME=entrega7

# Configuración de Embeddings y RAG
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_LANGUAGE=Español

#
REDIS_URL=redis://localhost:6379

HF_TOKEN=coloca aquí tu token de HF

DATA_DIR=./data
LOG_DIR=./log

#Observabilidad
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=entrega_7
