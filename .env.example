# Selecciona gemini, groq u openai e introduce la clave del proveedor elegido.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# RAG: Pinecone es requerido; el índice debe usar el mismo modelo/dimensión de embeddings.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=historia-urkd
PINECONE_NAMESPACE=historia-karate-uechi-ryu
EMBEDDING_MODEL_NAME=text-embedding-3-small
ANALYST_MAX_OUTPUT_CHARS=10000
DATA_DIR=./data

# Servicios locales provistos por docker compose.
REDIS_URL=redis://localhost:6379
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=entrega-7
PHOENIX_ENABLED=true
DEFAULT_LANGUAGE=Español
LOG_DIR=./log
